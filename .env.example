# Backend maintenance scripts only. Copy to the repository-root .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Configure exactly ONE backend credential. Never use a NEXT_PUBLIC prefix.
SUPABASE_SECRET_KEY=
# Legacy alternative, if using the project's existing service_role JWT:
# SUPABASE_SERVICE_ROLE_KEY=

# The frontend keeps its own public-only configuration in frontend/.env.
# Never put either backend credential in that file or Vercel NEXT_PUBLIC vars.

# Optional: repository-relative or absolute directory containing the verified
# checkpoint and tokenizer. No remote model fallback is used.
# SAFETRIP_MODEL_PATH=results/checkpoint-189
# SAFETRIP_CLUSTERING_CSV=data/baseline/clustering/clusters.csv
# Advisory ingestion still needs this missing source file before it can run:
# SAFETRIP_ISO_CSV=db/scripts/wikipedia-iso-country-codes.csv

# Local administrative backups only; never put this in the frontend.
# SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# For an installed wheel running outside the source checkout:
# SAFETRIP_PROJECT_ROOT=/path/to/project-or-runtime-assets
